<UserControl x:Class="Scrimshaw.App.Views.ReviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Scrimshaw.App.ViewModels"
             xmlns:views="clr-namespace:Scrimshaw.App.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ReviewViewModel}"
             d:DesignWidth="1100" d:DesignHeight="700">
    <UserControl.Resources>
        <views:PathToImageConverter x:Key="ThumbImage" DecodePixelWidth="200" />
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="196" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="270" />
        </Grid.ColumnDefinitions>

        <!-- Thumbnail strip (FR-A1, A8) -->
        <ListBox x:Name="FrameList" Grid.Column="0" ItemsSource="{Binding Frames}" SelectedItem="{Binding SelectedFrame}"
                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                 ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 BorderThickness="0,0,1,0" AutomationProperties.Name="Frames" AutomationProperties.AutomationId="FrameList">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:FrameItemViewModel}">
                    <Grid Width="164" Margin="0,3" AutomationProperties.Name="{Binding Seq, StringFormat=Frame {0}}">
                        <Border Height="94" BorderThickness="1" BorderBrush="#FFBBBBBB" Background="#FFEEEEEE">
                            <Grid>
                                <Image Source="{Binding ThumbPath, Converter={StaticResource ThumbImage}}" Stretch="Uniform" />
                                <Border Background="#B0FFFFFF" Visibility="{Binding Deleted, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Deleted" FontWeight="SemiBold" Foreground="Firebrick"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="3" Padding="6,0" CornerRadius="8"
                                        Background="#FF1E6FD9" ToolTip="Boxes on this frame"
                                        Visibility="{Binding BoxCount, Converter={StaticResource VisibleIfSet}}">
                                    <TextBlock Text="{Binding BoxCount}" Foreground="White" FontWeight="SemiBold" />
                                </Border>
                                <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="3" Padding="4,0" Background="#AA000000">
                                    <TextBlock Text="{Binding Seq}" Foreground="White" FontSize="11" />
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Editor -->
        <DockPanel Grid.Column="1">
            <Border DockPanel.Dock="Top" Padding="8,6" BorderThickness="0,0,0,1" BorderBrush="{x:Static SystemColors.ActiveBorderBrush}">
                <WrapPanel>
                    <WrapPanel.Resources>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Margin" Value="0,0,6,0" />
                        </Style>
                    </WrapPanel.Resources>
                    <Button Content="◀ Previous" Command="{Binding PreviousFrameCommand}" ToolTip="Previous frame (←)" AutomationProperties.AutomationId="PreviousFrame" />
                    <Button Content="Next ▶" Command="{Binding NextFrameCommand}" ToolTip="Next frame (→)" AutomationProperties.AutomationId="NextFrame" />
                    <Button Content="Fit" Click="OnFit" ToolTip="Fit the frame to the window (F)" AutomationProperties.AutomationId="Fit" />
                    <Button Content="Undo" Command="{Binding UndoCommand}" ToolTip="{Binding UndoText, TargetNullValue='Nothing to undo', StringFormat='Undo: {0} (Ctrl+Z)'}"
                            AutomationProperties.AutomationId="Undo" />
                    <Button Content="Redo" Command="{Binding RedoCommand}" ToolTip="{Binding RedoText, TargetNullValue='Nothing to redo', StringFormat='Redo: {0} (Ctrl+Y)'}"
                            AutomationProperties.AutomationId="Redo" />
                    <Button Content="Copy boxes from previous" Command="{Binding CopyFromPreviousCommand}" ToolTip="Ctrl+Shift+V"
                            AutomationProperties.AutomationId="CopyFromPrevious" />
                    <Button Content="Apply boxes to following frames" Command="{Binding ApplyToFollowingCommand}"
                            ToolTip="Copy this frame's boxes to every later frame that has none yet (Ctrl+Shift+A)"
                            AutomationProperties.AutomationId="ApplyToFollowing" />
                    <Button Command="{Binding ToggleFrameDeletedCommand}" ToolTip="Ctrl+D" AutomationProperties.AutomationId="ToggleFrameDeleted">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Content" Value="Delete frame" />
                                <Setter Property="Margin" Value="0,0,6,0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedFrame.Deleted}" Value="True">
                                        <Setter Property="Content" Value="Restore frame" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </WrapPanel>
            </Border>
            <TextBlock DockPanel.Dock="Bottom" Margin="8,4" Text="{Binding FramePosition}" AutomationProperties.AutomationId="FramePosition" />
            <Grid>
                <views:AnnotationSurface x:Name="Surface"
                                         ImagePath="{Binding SelectedFrame.Path}"
                                         ImageVersion="{Binding SelectedFrame.ImageVersion}"
                                         IsDimmed="{Binding SelectedFrame.Deleted}"
                                         Boxes="{Binding Boxes}"
                                         SelectedBox="{Binding SelectedBox}"
                                         Host="{Binding}"
                                         AutomationProperties.Name="Frame editor"
                                         AutomationProperties.AutomationId="Surface" />
                <TextBlock Text="No frames yet. Capture a video first." Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding HasFrame, Converter={StaticResource HiddenIfTrue}}" />
            </Grid>
        </DockPanel>

        <!-- Boxes and labels -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" BorderThickness="1,0,0,0">
            <StackPanel Margin="12">
                <TextBlock Text="Boxes on this frame" Style="{StaticResource SectionHeader}" />
                <ListBox ItemsSource="{Binding Boxes}" SelectedItem="{Binding SelectedBox}" MinHeight="60" MaxHeight="260"
                         AutomationProperties.Name="Boxes" AutomationProperties.AutomationId="BoxList">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:BoxViewModel}">
                            <StackPanel Margin="0,2">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Hint}" Margin="0" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Text="Drag on the frame to draw a box." Style="{StaticResource Hint}"
                           Visibility="{Binding Boxes.Count, Converter={StaticResource VisibleIfUnset}}" />

                <StackPanel IsEnabled="{Binding HasSelectedBox}" Margin="0,12,0,0">
                    <TextBlock Text="Label (becomes a PDF bookmark)" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                    <TextBox x:Name="LabelBox" Text="{Binding LabelText, UpdateSourceTrigger=PropertyChanged}"
                             KeyDown="OnLabelKeyDown" LostKeyboardFocus="OnLabelLostFocus"
                             AutomationProperties.Name="Box label" AutomationProperties.AutomationId="Label" />
                    <TextBlock Text="Press Enter to save the label." Style="{StaticResource Hint}" />
                    <Button Content="Delete box" HorizontalAlignment="Left" Margin="0,10,0,0" Command="{Binding DeleteSelectedBoxCommand}"
                            ToolTip="Delete" AutomationProperties.AutomationId="DeleteBox" />
                </StackPanel>

                <TextBlock Text="Shortcuts" Style="{StaticResource SectionHeader}" Margin="0,20,0,6" />
                <TextBlock Style="{StaticResource Hint}" Margin="0" LineHeight="20">
                    ← / → previous / next frame<LineBreak />
                    Delete — delete the selected box<LineBreak />
                    Ctrl+Z / Ctrl+Y — undo / redo<LineBreak />
                    Ctrl+Shift+V — copy boxes from previous<LineBreak />
                    Ctrl+Shift+A — apply boxes to following<LineBreak />
                    Ctrl+D — delete or restore the frame<LineBreak />
                    Enter — edit the selected box's label<LineBreak />
                    F — fit · wheel — zoom · right-drag — pan
                </TextBlock>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
