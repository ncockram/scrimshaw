<Window x:Class="Scrimshaw.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Scrimshaw.App.ViewModels"
        xmlns:views="clr-namespace:Scrimshaw.App.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="Scrimshaw" Icon="/Assets/scrimshaw.ico" Width="1100" Height="740" MinWidth="900" MinHeight="600"
        AutomationProperties.AutomationId="MainWindow">
    <DockPanel>
        <!-- Workspace bar -->
        <Border DockPanel.Dock="Top" Padding="12,8" BorderThickness="0,0,0,1"
                BorderBrush="{x:Static SystemColors.ActiveBorderBrush}">
            <DockPanel>
                <Button DockPanel.Dock="Left" Content="New workspace…" Command="{Binding NewWorkspaceCommand}"
                        AutomationProperties.AutomationId="NewWorkspace" />
                <Button DockPanel.Dock="Left" Content="Open workspace…" Margin="8,0,0,0" Command="{Binding OpenWorkspaceCommand}"
                        AutomationProperties.AutomationId="OpenWorkspace" />
                <Menu DockPanel.Dock="Left" Margin="8,0,0,0" VerticalAlignment="Center" Background="Transparent">
                    <MenuItem Header="Recent ▾" ItemsSource="{Binding RecentWorkspaces}" Padding="8,4"
                              IsEnabled="{Binding HasRecent}"
                              AutomationProperties.AutomationId="Recent">
                        <MenuItem.ItemContainerStyle>
                            <Style TargetType="MenuItem">
                                <Setter Property="Header" Value="{Binding}" />
                                <Setter Property="Command" Value="{Binding DataContext.OpenRecentCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                <Setter Property="CommandParameter" Value="{Binding}" />
                            </Style>
                        </MenuItem.ItemContainerStyle>
                    </MenuItem>
                </Menu>
                <Button DockPanel.Dock="Right" Content="About" Margin="8,0,0,0" Click="OnAbout" AutomationProperties.AutomationId="About" />
                <TextBlock Margin="16,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Text="{Binding WorkspacePath, TargetNullValue='No workspace open. Create a new one for each video.'}"
                           ToolTip="{Binding WorkspacePath}" AutomationProperties.AutomationId="WorkspacePath" />
            </DockPanel>
        </Border>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" AutomationProperties.AutomationId="StatusMessage" />
            </StatusBarItem>
        </StatusBar>

        <TabControl SelectedIndex="{Binding SelectedTab}" Margin="0,4,0,0" AutomationProperties.AutomationId="Tabs">
            <TabItem Header="  Capture  " AutomationProperties.AutomationId="TabCapture">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="350" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Capture panel -->
                        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="12,8,12,12" IsEnabled="{Binding HasWorkspace}">
                                <StackPanel.Resources>
                                    <!-- Tighter spacing for this panel only, so it fits a 1080p screen at 125% -->
                                    <Style x:Key="FieldLabel" TargetType="TextBlock">
                                        <Setter Property="Margin" Value="0,8,0,3" />
                                    </Style>
                                    <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                        <Setter Property="Foreground" Value="{x:Static SystemColors.GrayTextBrush}" />
                                        <Setter Property="TextWrapping" Value="Wrap" />
                                        <Setter Property="Margin" Value="0,3,0,0" />
                                    </Style>
                                </StackPanel.Resources>
                                <TextBlock Text="Capture" Style="{StaticResource SectionHeader}" Margin="0,0,0,4" />

                                <TextBlock Text="What to capture" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Refresh" Margin="6,0,0,0" ToolTip="Refresh the list of screens and windows"
                                            Command="{Binding RefreshTargetsCommand}" IsEnabled="{Binding CanEditSettings}"
                                            AutomationProperties.Name="Refresh targets" AutomationProperties.AutomationId="RefreshTargets" />
                                    <ComboBox ItemsSource="{Binding Targets}" SelectedItem="{Binding SelectedTarget}"
                                              DisplayMemberPath="DisplayName" IsEnabled="{Binding CanEditSettings}"
                                              AutomationProperties.Name="What to capture" AutomationProperties.AutomationId="Target" />
                                </DockPanel>
                                <TextBlock Style="{StaticResource Hint}" Text="Tip: browser window, video full screen, mouse off the video. (hover for more)"
                                           ToolTip="For a YouTube video, pick the browser window and use theatre or full-screen mode. Keep the mouse off the video, keep the window fully on screen, and turn off autoplay (or leave 'Stop when the window's title changes' ticked)." />

                                <DockPanel Margin="0,8,0,0">
                                    <TextBlock Text="Seconds between captures" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <TextBox Text="{Binding IntervalText, UpdateSourceTrigger=PropertyChanged}" Width="70" HorizontalAlignment="Left"
                                             IsEnabled="{Binding CanEditSettings}"
                                             AutomationProperties.Name="Seconds between captures" AutomationProperties.AutomationId="Interval" />
                                </DockPanel>
                                <TextBlock Text="{Binding IntervalError}" Style="{StaticResource ErrorText}"
                                           Visibility="{Binding IntervalError, Converter={StaticResource VisibleIfSet}}" />

                                <TextBlock Style="{StaticResource FieldLabel}">
                                    <Run Text="New page when at least" />
                                    <Run Text="{Binding ThresholdPercent, StringFormat={}{0:0}%, Mode=OneWay}" FontWeight="SemiBold" />
                                    <Run Text="of the picture changes" />
                                </TextBlock>
                                <Slider Minimum="1" Maximum="30" TickFrequency="1" IsSnapToTickEnabled="True"
                                        Value="{Binding ThresholdPercent}" IsEnabled="{Binding CanEditSettings}"
                                        AutomationProperties.Name="Change threshold percent" AutomationProperties.AutomationId="Threshold" />
                                <ProgressBar Height="6" Margin="0,4,0,0" Minimum="0" Maximum="30"
                                             Value="{Binding LastChangePercent, Mode=OneWay, TargetNullValue=0}"
                                             AutomationProperties.Name="Last change" />
                                <TextBlock Text="{Binding LastChangeText}" Style="{StaticResource Hint}" AutomationProperties.AutomationId="LastChange" />

                                <TextBlock Text="Image format" Style="{StaticResource FieldLabel}" />
                                <StackPanel Orientation="Horizontal" IsEnabled="{Binding CanChangeFormat}">
                                    <RadioButton GroupName="Format" Content="PNG (lossless)" IsChecked="{Binding IsJpeg, Converter={StaticResource InverseBool}}"
                                                 AutomationProperties.AutomationId="FormatPng" />
                                    <RadioButton GroupName="Format" Content="JPEG (smaller)" Margin="16,0,0,0" IsChecked="{Binding IsJpeg}"
                                                 AutomationProperties.AutomationId="FormatJpeg" />
                                </StackPanel>
                                <DockPanel Margin="0,6,0,0" Visibility="{Binding IsJpeg, Converter={StaticResource BoolToVisibility}}"
                                           IsEnabled="{Binding CanChangeFormat}">
                                    <TextBlock DockPanel.Dock="Left" Text="Quality" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding JpegQuality}" Width="28" TextAlignment="Right" VerticalAlignment="Center" />
                                    <Slider Minimum="50" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding JpegQuality}"
                                            AutomationProperties.Name="JPEG quality" />
                                </DockPanel>
                                <TextBlock Style="{StaticResource Hint}" Text="The format can't change once the workspace has frames."
                                           Visibility="{Binding FrameCount, Converter={StaticResource VisibleIfSet}}" />

                                <CheckBox Content="Include the mouse pointer" Margin="0,10,0,0" IsChecked="{Binding IncludeCursor}"
                                          IsEnabled="{Binding CanEditSettings}" AutomationProperties.AutomationId="IncludeCursor" />
                                <CheckBox Margin="0,4,0,0" IsChecked="{Binding StopOnTitleChange}" IsEnabled="{Binding CanStopOnTitleChange}"
                                          AutomationProperties.AutomationId="StopOnTitleChange">
                                    <TextBlock TextWrapping="Wrap" Text="Stop when the window's title changes (e.g. the next video starts)" />
                                </CheckBox>

                                <Grid Margin="0,12,0,0">
                                    <Button Content="Start capture" FontWeight="SemiBold" Padding="10,8"
                                            Command="{Binding StartCaptureCommand}"
                                            Visibility="{Binding IsCapturing, Converter={StaticResource HiddenIfTrue}}"
                                            AutomationProperties.AutomationId="StartCapture" />
                                    <Button Content="Stop capture" FontWeight="SemiBold" Padding="10,8"
                                            Command="{Binding StopCaptureCommand}"
                                            Visibility="{Binding IsCapturing, Converter={StaticResource BoolToVisibility}}"
                                            AutomationProperties.AutomationId="StopCapture" />
                                </Grid>
                                <TextBlock x:Name="HotkeyHint" Style="{StaticResource Hint}" Text="Ctrl+Alt+S starts and stops capture from any app." />

                                <TextBlock Text="This capture" Style="{StaticResource SectionHeader}" Margin="0,14,0,4" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                    </Grid.RowDefinitions>
                                    <Grid.Resources>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Margin" Value="0,1,10,1" />
                                        </Style>
                                    </Grid.Resources>
                                    <TextBlock Grid.Row="0" Text="Time" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ElapsedText}" AutomationProperties.AutomationId="StatElapsed" />
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Captures" />
                                    <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding Stats.Attempts}" AutomationProperties.AutomationId="StatAttempts" />
                                    <TextBlock Grid.Row="1" Text="Pages saved" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Stats.Saved}" AutomationProperties.AutomationId="StatSaved" />
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Skipped" ToolTip="Captures thrown away because nothing changed" />
                                    <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding Stats.Discarded}" AutomationProperties.AutomationId="StatDiscarded" />
                                    <TextBlock Grid.Row="2" Text="Settling" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" AutomationProperties.AutomationId="StatSettling">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="no" />
                                                <Setter Property="Margin" Value="0,1,10,1" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Stats.Settling}" Value="True">
                                                        <Setter Property="Text" Value="yes, waiting for the page to stop changing" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Grid.Row="3" Text="Timing" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding TimingText}" AutomationProperties.AutomationId="StatTiming" />
                                    <TextBlock Grid.Row="4" Text="Cleaner kept"
                                               ToolTip="A page saved while the player's controls were showing was swapped for the clean version shown afterwards."
                                               Visibility="{Binding Stats.Replaced, Converter={StaticResource VisibleIfSet}}" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Stats.Replaced}" AutomationProperties.AutomationId="StatReplaced"
                                               Visibility="{Binding Stats.Replaced, Converter={StaticResource VisibleIfSet}}" />
                                    <TextBlock Grid.Row="4" Grid.Column="2" Text="Dropped" Foreground="Firebrick" ToolTip="Pages lost because the disk was too slow"
                                               Visibility="{Binding Stats.Dropped, Converter={StaticResource VisibleIfSet}}" />
                                    <TextBlock Grid.Row="4" Grid.Column="3" Text="{Binding Stats.Dropped}" Foreground="Firebrick"
                                               Visibility="{Binding Stats.Dropped, Converter={StaticResource VisibleIfSet}}" />
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Frame area: live preview of the selected source (FR-C13) or the latest saved frame -->
                        <DockPanel Grid.Column="1" Margin="12">
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <Button DockPanel.Dock="Right" Content="Show preview" Command="{Binding ShowPreviewCommand}"
                                        ToolTip="Show a live preview of the selected source (nothing is saved)"
                                        AutomationProperties.AutomationId="ShowPreview" />
                                <TextBlock Text="{Binding FrameAreaHeader}" Style="{StaticResource SectionHeader}" Margin="0" VerticalAlignment="Center"
                                           AutomationProperties.AutomationId="FrameAreaHeader" />
                            </DockPanel>
                            <Border BorderThickness="1" Background="#FFF4F4F4">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="{x:Static SystemColors.ActiveBorderBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPreviewing}" Value="True">
                                                <Setter Property="BorderBrush" Value="#FFE67E22" />
                                                <Setter Property="BorderThickness" Value="2" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <!-- Latest saved frame -->
                                    <Grid Visibility="{Binding IsPreviewing, Converter={StaticResource HiddenIfTrue}}">
                                        <Image Source="{Binding LatestFramePath, Converter={StaticResource PathToImage}}" Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.AutomationId="LatestFrame" />
                                        <TextBlock Text="Choose what to capture to preview it here. Saved frames appear here as pages are captured."
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Style="{StaticResource Hint}"
                                                   Visibility="{Binding LatestFramePath, Converter={StaticResource VisibleIfUnset}}" />
                                    </Grid>
                                    <!-- Live preview -->
                                    <Grid Visibility="{Binding IsPreviewing, Converter={StaticResource BoolToVisibility}}">
                                        <Image Source="{Binding PreviewImage}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                                               AutomationProperties.Name="Preview" AutomationProperties.AutomationId="PreviewImage" />
                                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Padding="8,2" CornerRadius="3"
                                                Background="#E6E67E22">
                                            <!-- The id goes on the text: a Border isn't exposed to UI Automation -->
                                            <TextBlock Text="PREVIEW · not saved" Foreground="White" FontWeight="SemiBold"
                                                       AutomationProperties.AutomationId="PreviewBadge" />
                                        </Border>
                                        <TextBlock Text="{Binding PreviewProblem}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                                                   FontSize="14" Margin="24" TextAlignment="Center" AutomationProperties.AutomationId="PreviewProblem"
                                                   Visibility="{Binding PreviewProblem, Converter={StaticResource VisibleIfSet}}" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </DockPanel>
                    </Grid>
            </TabItem>
            <TabItem Header="  Review and box  " IsEnabled="{Binding HasWorkspace}" AutomationProperties.AutomationId="TabReview">
                <views:ReviewView DataContext="{Binding Review}" />
            </TabItem>
            <TabItem Header="  Export PDF  " IsEnabled="{Binding HasWorkspace}" AutomationProperties.AutomationId="TabExport">
                <views:ExportView DataContext="{Binding ExportTab}" />
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
