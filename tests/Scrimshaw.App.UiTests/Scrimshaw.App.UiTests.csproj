<Project Sdk="Microsoft.NET.Sdk">
  <!-- Drives the real app with UI Automation (FlaUI). Desktop only: run by arrangement (implementation plan §11). -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="System.IO" />
    <!-- Only Screen is needed from WinForms; keep its names out of scope (they clash with FlaUI's). -->
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FlaUI.Core" />
    <PackageReference Include="FlaUI.UIA3" />
    <ProjectReference Include="..\..\src\Scrimshaw.Core\Scrimshaw.Core.csproj" />
    <ProjectReference Include="..\..\src\Scrimshaw.Imaging\Scrimshaw.Imaging.csproj" />
    <!-- Build order only: the tests launch the app's exe. -->
    <ProjectReference Include="..\..\src\Scrimshaw.App\Scrimshaw.App.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
