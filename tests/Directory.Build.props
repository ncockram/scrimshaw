<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- Test method names use underscores for readability. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
    <IsSharedTestSupport Condition="'$(MSBuildProjectName)' == 'Scrimshaw.TestSupport'">true</IsSharedTestSupport>
  </PropertyGroup>
  <PropertyGroup Condition="'$(IsSharedTestSupport)' != 'true'">
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup Condition="'$(IsSharedTestSupport)' != 'true'">
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
