<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <AssemblyName>scrimshaw-harness</AssemblyName>
    <UseWPF>true</UseWPF>
  </PropertyGroup>
  <ItemGroup>
    <!-- UseWPF drops System.IO from implicit usings -->
    <Using Include="System.IO" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Scrimshaw.Core\Scrimshaw.Core.csproj" />
    <ProjectReference Include="..\..\src\Scrimshaw.Imaging\Scrimshaw.Imaging.csproj" />
  </ItemGroup>
</Project>
